{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/campaign/brain.js": {
      "maxDuration": 300,
      "includeFiles": "campaign-import/**"
    },
    "api/meta/account-snapshot.js": {
      "maxDuration": 300
    },
    "api/klaviyo/subscriber-history.js": {
      "maxDuration": 300
    },
    "api/klaviyo/campaign-overview.js": {
      "maxDuration": 300
    },
    "api/canva/localizer.js": {
      "maxDuration": 300
    },
    "api/openai/klaviyo-translate-template.js": {
      "maxDuration": 300
    },
    "api/klaviyo/subject-lines.js": {
      "maxDuration": 300,
      "includeFiles": "knowledge/subject-lines/pattern-bank.vectors.*"
    },
    "api/agents.js": {
      "maxDuration": 300,
      "includeFiles": "knowledge/westpack-site/README.md"
    },
    "api/signup/control.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/meta/account-snapshot",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/meta/account-snapshot?historical=sync",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/klaviyo/subscriber-history",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/meta/account-snapshot?expansion=sync",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/klaviyo/subject-lines?action=sync_history",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/agents?action=watchdog_run",
      "schedule": "7 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/signup/assets/fonts/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/signup/assets/(.*).webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
