secrets
*.ps1
*.docx
meta-config.template.json
klaviyo-config.json
META_SETUP.md
START_APP.txt
README.md
# The pattern above matches a README at any depth, which also kept the site facts out of the upload, so
# api/agents.js's includeFiles bundled nothing and every Email check ran without them ("not in the site facts").
# Only this one is needed by a function; the other READMEs are internal team docs and stay out.
!knowledge/westpack-site/README.md
campaign-memory

# Environment files. These live in the project root (.env.local, .env.production) and hold
# the Meta and OpenAI credentials. Vercel injects real environment variables from the
# project settings, so these must never be part of an upload.
.env
.env.*

# Local debug and capture artifacts. All of these are gitignored but were not excluded from
# deploys, so a folder deploy would have published them as static files on the production
# domain, reachable by anyone who guessed the path.
_login_headers.txt
_live_catalog.json
_live_snapshot_*.json
_write_ok.txt
_tiny_test.mp4
westpack-fr-check.png
*.tmp
*.log
local-debug.*
local-serve.*
local-email-audit.*
serve-local-wrapper.*
vercel-dev*.log
tmp/
tmp-*/
tmp-*.png
tmp-*.mp4
test-results/

# Local-mode stores of the subject line generator. Production keeps them in Blob; the local copies
# hold every account's send figures and must never be served as static files.
data/klaviyo-subject-line-history.json
data/klaviyo-subject-line-team.json
data/klaviyo-subject-line-tags.json

# Not needed at runtime.
tests/
.claude/
DEPLOY_VERCEL.txt
META_DASHBOARD_REFACTOR.md
CLAUDE.md

# Ad templates are rendered on a laptop and uploaded to Meta from there; the app never reads them.
templates/
